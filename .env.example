PORT="8080"
MONGO_URI="mongodb+srv://<user>:<password>@cluster.mongodb.net/"
DB_NAME="ar-code-prod"
SECRET="your-jwt-secret-key-here"

# Cloudflare R2 Credentials
CF_ACCOUNT_ID="your-cloudflare-account-id"
CF_ACCESS_KEY_ID="your-r2-access-key-id"
CF_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CDN_DOMAIN="r2.gamchngr.xyz"
R2_BUCKET_NAME="ar-models"

# Redis
REDIS_ADDR="redis:6379"
REDIS_PASSWORD=""

# Frontend & Viewer URLs
CORS_ORIGINS="https://ar.gamchngr.xyz,https://v.gamchngr.xyz,http://localhost:3000"
VIEWER_URL="https://v.gamchngr.xyz"
